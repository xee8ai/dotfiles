[alias]
    pullall = !git pull && git submodule update --init --recursive
[blame]
    ignoreRevsFile = .git-blame-ignore-revs
    # optional: show `?` on lines git cannot re-attribute after skipping a rev
    markUnblamableLines = true
    # optional: prefix `*` on lines that came from an ignored rev
    markIgnoredLines = true
[color]
    ui = auto
[core]
    editor = vim
[diff]
    tool = vimdiff
[merge]
    tool = vimdiff
    conflictstyle = diff3
[difftool]
    prompt = false
[mergetool]
    prompt = false
    keepBackup = false
[pull]
    ff = only
[push]
    default = simple
